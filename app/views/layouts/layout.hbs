<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Site2Api Console</title>
    
    <!-- Используем хелпер static для статических файлов -->
    <link rel="stylesheet" type="text/css" href="{{static '/style/main.css'}}">
    <style type="text/css" media="screen">
    </style>
    <!-- Внешние CDN-ресурсы остаются без изменений -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script type="text/javascript" src="{{static '/lib/jquery-2.1.4.min.js'}}"></script>
    <script type="text/javascript" src="{{static '/script/main.js'}}"></script>
</head>
<body>

    {{#if isLogin}}
    {{else}}
        <div class="sidenav">
            <!-- Используем хелпер url для всех внутренних ссылок -->
            <a href="{{url '/console'}}">Проекты</a>
            <a href="{{url '/console/logdump'}}">История</a>
            <a href="{{url '/console/edit?entity=dbexport&id=notused&action=edit'}}">Импорт БД</a>
            <a href="{{url '/console/edit?entity=config&id=0&action=edit'}}">Настройки</a>
            <a href="https://github.com/poetofcode/site2api">Помощь</a>
            <a href="#" class="menu-logout">Выход</a>
        </div>
    {{/if}}

    {{{body}}}

    <script type="text/javascript">
        function logout() {
            console.log(`Logout...`)

            // Используем apiUrl хелпер для API-запросов
            // Примечание: хелпер не работает напрямую в JS, поэтому используем переменную
            const apiPath = '{{apiUrl "/sessions/"}}' + getCookie('token');
            fetch(apiPath, {
                method: 'DELETE',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                },
            })
            .then(response => {
                response
                    .json()
                    .then(data => {
                        if (data.result) {
                            // Используем url хелпер для редиректа
                            window.location.href = '{{url "/console/login"}}';
                            return;
                        }
                        if (!data.result) {
                            showToast(data.error, true);
                        }
                        console.log(JSON.stringify(data));
                    })
                    .catch(err => {
                        showToast(err.message, true);
                        console.log(err);
                    });
            })
            .catch(err => {
                showToast(err.message, true);
                console.log(err);
            });
        }

        $('.menu-logout').click(function(e) {
            e.preventDefault();
            if (confirm(`Уверены, что хотите выйти из аккаунта?`)) {
                logout();
            } 
        });
    </script>

</body>
</html>